# ---------------------------------------------------------------------------
# NeuraChat - environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_NAME=NeuraChat
# development | production
ENVIRONMENT=development
DEBUG=false

# --- Database --------------------------------------------------------------
# Local dev (default): SQLite file next to the app.
DATABASE_URL=sqlite:///./neurachat.db
# Production (docker-compose provides this automatically):
# DATABASE_URL=postgresql+psycopg2://neurachat:neurachat@db:5432/neurachat

# --- Auth ------------------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
# Token lifetime in minutes (default 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM provider ----------------------------------------------------------
# auto   -> use OpenAI if OPENAI_API_KEY is set, otherwise the local demo engine
# openai -> force the OpenAI-compatible engine
# local  -> force the offline demo engine
LLM_PROVIDER=auto
# Leave blank to run in demo mode (the app still works end-to-end).
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works (OpenAI, Azure, Groq, Together, Ollama...).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# --- Security --------------------------------------------------------------
# Comma-separated list of allowed origins, or * for any (dev only).
CORS_ORIGINS=*
# Requests allowed per client IP per minute.
RATE_LIMIT_PER_MINUTE=60
